{
  "pluginId": "lookdevtools-intermediate",
  "displayName": "Look Dev Tools (Intermediate - Defaults)",
  "type": "OFX",
  "releaseRepo": "Dec18studios/LookDevTools-OFX",
  "minManagerVersion": "0.1.0",
  "hostProcesses": ["Resolve", "DaVinci Resolve", "Fusion", "Fusion Studio", "Nuke", "NukeX", "NukeStudio", "Hiero"],
  "requiredFamilies": ["macos"],
  "category": "Color Grading",
  "description": "Look Dev Tools, built from the same source with the Working Space default set to DaVinci Intermediate (log timelines) instead of scene-linear. Identical plugin and bundle in every other respect — same plugin id, so it installs over and replaces the standard edition. Pick whichever default matches your timeline. Saved nodes/presets store an explicit working space, so existing grades render identically across editions.",
  "licenseTier": "subscription",
  "tags": ["look dev", "color grading", "hue", "saturation", "OFX", "GPU", "intermediate", "log"],
  "assetRules": [
    {
      "family": "macos",
      "platform": "macos",
      "arch": "universal",
      "assetPattern": "LookDevTools.*macOS.*universal.*portable_intermediate\\.zip$",
      "packageType": "zip",
      "bundleName": "LookDevTools.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.LookDevTools",
      "installPath": "/Library/OFX/Plugins"
    },
    {
      "family": "windows",
      "platform": "windows",
      "arch": "x86_64",
      "assetPattern": "LookDevTools.*windows.*portable_intermediate\\.zip$",
      "packageType": "zip",
      "bundleName": "LookDevTools.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.LookDevTools",
      "installPath": "C:\\Program Files\\Common Files\\OFX\\Plugins"
    },
    {
      "family": "linux",
      "platform": "linux",
      "arch": "x86_64",
      "assetPattern": "LookDevTools.*linux.*portable_intermediate\\.zip$",
      "packageType": "zip",
      "bundleName": "LookDevTools.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.LookDevTools",
      "installPath": "/usr/OFX/Plugins"
    }
  ]
}
