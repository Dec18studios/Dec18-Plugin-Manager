      "arch": "universal",
      "assetPattern": "^LookNotes_macOS_universal\\.zip$",
      "packageType": "zip",
      "bundleName": "LookNotes.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.LookNotes",
      "installPath": "/Library/OFX/Plugins"
    },
    {
      "family": "windows",
      "platform": "windows",
      "arch": "x86_64",
