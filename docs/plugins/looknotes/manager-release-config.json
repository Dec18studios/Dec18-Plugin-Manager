{
  "pluginId": "looknotes",
  "displayName": "Look Notes Pro",
  "type": "OFX",
  "releaseRepo": "Dec18studios/Look-Notes-OFX",
  "minManagerVersion": "0.1.0",
  "hostProcesses": [
    "Resolve",
    "DaVinci Resolve",
    "Fusion",
    "Fusion Studio",
    "Nuke",
    "NukeX",
    "NukeStudio",
    "Hiero"
  ],
  "requiredFamilies": [
    "macos"
