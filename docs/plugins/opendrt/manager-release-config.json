{
  "pluginId": "opendrt",
  "displayName": "OpenDRT",
  "type": "OFX",
  "releaseRepo": "Dec18studios/Open-DRT-OFX",
  "minManagerVersion": "0.1.0",
  "hostProcesses": ["Resolve", "DaVinci Resolve", "Fusion", "Fusion Studio", "Nuke", "NukeX", "NukeStudio", "Hiero"],
  "requiredFamilies": ["macos"],
  "category": "Color Grading",
  "description": "Jed Smith's open-source display rendering transform, free as an OFX plugin. GPU-accelerated (Metal on macOS, CUDA on Windows/Linux) with 16 selectable input gamuts and the full look-dev module set. GPL-3.0; built from the public Open-DRT-OFX source with attribution to Jed Smith.",
  "licenseTier": "free",
  "tags": ["DRT", "display rendering transform", "tone mapping", "OFX", "GPU", "open source"],
  "assetRules": [
    {
      "family": "macos",
      "platform": "macos",
      "arch": "universal",
      "assetPattern": "OpenDRT.*macOS.*universal.*\\.zip$",
      "packageType": "zip",
      "bundleName": "OpenDRT.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.OpenDRT",
      "installPath": "/Library/OFX/Plugins"
    },
    {
      "family": "windows",
      "platform": "windows",
      "arch": "x86_64",
      "assetPattern": "OpenDRT.*windows.*\\.zip$",
      "packageType": "zip",
      "bundleName": "OpenDRT.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.OpenDRT",
      "installPath": "C:\\Program Files\\Common Files\\OFX\\Plugins"
    },
    {
      "family": "linux",
      "platform": "linux",
      "arch": "x86_64",
      "assetPattern": "OpenDRT.*linux.*\\.zip$",
      "packageType": "zip",
      "bundleName": "OpenDRT.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.OpenDRT",
      "installPath": "/usr/OFX/Plugins"
    }
  ]
}
