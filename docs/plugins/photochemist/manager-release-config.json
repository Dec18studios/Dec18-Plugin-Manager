  "infoUrl": "https://dec18studios.com/photochemist",
  "_demoComment": "sha256 is resolved live from the demo release's asset.digest by the generator (the demo tag is delete+recreated each build, so the hash changes every release). Pin version + downloadUrl only; add a sha256 under an asset here only to force a manual override.",
  "demo": {
    "version": "2.7.0",
    "assets": {
      "macos-universal": {
        "downloadUrl": "https://github.com/Dec18studios/PhotoChemist-Demo/releases/download/v2.7.0/PhotoChemistDemo_macOS_universal_portable.zip"
      },
      "windows-x86_64": {
        "downloadUrl": "https://github.com/Dec18studios/PhotoChemist-Demo/releases/download/v2.7.0/PhotoChemistDemo_windows_cuda_portable.zip"
      },
      "linux-x86_64": {
        "downloadUrl": "https://github.com/Dec18studios/PhotoChemist-Demo/releases/download/v2.7.0/PhotoChemistDemo_linux_cuda_portable.zip"
      }
    }
  },
  "assetRules": [
    {
      "family": "macos",
      "platform": "macos",
      "arch": "universal",
      "assetPattern": "PhotoChemist.*macOS.*universal.*\\.zip$",
      "packageType": "zip",
      "bundleName": "PhotoChemist.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.PhotoChemist",
      "installPath": "/Library/OFX/Plugins"
    },
    {
      "family": "windows",
      "platform": "windows",
      "arch": "x86_64",
      "assetPattern": "PhotoChemist.*[Ww]indows.*x86_64.*\\.zip$",
      "packageType": "zip",
      "bundleName": "PhotoChemist.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.PhotoChemist",
      "installPath": "C:\\Program Files\\Common Files\\OFX\\Plugins"
    },
    {
      "family": "linux",
      "platform": "linux",
      "arch": "x86_64",
      "assetPattern": "PhotoChemist.*linux.*x86_64.*\\.tar\\.gz$",
      "packageType": "tar.gz",
      "bundleName": "PhotoChemist.ofx.bundle",
      "bundleIdentifier": "com.dec18studios.PhotoChemist",
      "installPath": "/usr/OFX/Plugins"
    }
  ]
}
